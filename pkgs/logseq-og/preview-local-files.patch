+(rum/defcs text-file-preview < rum/reactive
+  {:will-mount
+   (fn [state]
+     (let [*result (atom nil)
+           [file-path] (:rum/args state)]
+       (-> (js/window.apis.readTextFilePreview file-path)
+           (p/then #(reset! *result (bean/->clj %)))
+           (p/catch (fn [_] (reset! *result {:error true}))))
+       (assoc state ::preview-result *result)))}
+  [state file-path]
+  (let [{:keys [text truncated error] :as result} (rum/react (::preview-result state))]
+    [:div.tippy-wrapper.text-file-preview.p-4
+     {:style {:width 600 :max-width "calc(100vw - 48px)" :text-align "left"}}
+     [:div.font-semibold.mb-2 {:style {:overflow-wrap "anywhere"}}
+      (.basename util/node-path file-path)]
+     (cond
+       (nil? result) (ui/loading)
+       error [:div.opacity-70 "Unable to read this file."]
+       (= text "") [:div.opacity-70 "Empty file"]
+       :else [:pre.text-sm
+              {:style {:white-space "pre-wrap" :overflow-wrap "anywhere"
+                       :max-height 320 :overflow-y "auto" :margin 0}}
+              text])
+     (when truncated [:div.text-sm.opacity-70.mt-2 "…"])
+     [:div.text-xs.opacity-70.mt-3 "Click the link to open the full file."]]))
+
+(rum/defc text-file-preview-trigger
+  [file-path child]
+  (ui/tippy {:in-editor? true
+             :html #(rum/with-key (text-file-preview file-path) file-path)
+             :interactive true
+             :delay [1000 100]
+             :position "top"
+             :distance 10
+             :popperOptions {:modifiers {:preventOverflow
+                                         {:enabled true :boundariesElement "viewport"}}}}
+            child))
+
+(defn- desktop-local-file-link
+  [config file-path label title]
+  (let [ext (keyword (util/get-file-ext file-path))
+        label (->elem :span (map-inline config label))]
+    (cond
+      (contains? (gp-config/text-formats) ext)
+      (let [link [:a.asset-ref.is-plaintext
+                  {:href (rfe/href :file {:path file-path})
+                   :title title
+                   :on-click (fn [event]
+                               (util/stop event)
+                               (rfe/push-state :file {:path file-path}))}
+                  label]]
+        (if (= ext :txt)
+          (text-file-preview-trigger file-path link)
+          link))
+
+      (= ext :pdf)
+      [:a.asset-ref.is-pdf
+       {:data-href file-path :title title :role "button" :tab-index 0
+        :on-click (fn [event]
+                    (util/stop event)
+                    (when-let [asset (pdf-assets/inflate-asset file-path)]
+                      (state/set-current-pdf! asset)))
+        :on-key-down (fn [event]
+                       (when (contains? #{"Enter" " "} (.-key event))
+                         (util/stop event)
+                         (when-let [asset (pdf-assets/inflate-asset file-path)]
+                           (state/set-current-pdf! asset))))}
+       label]
+
+      :else
+      [:a {:href (path/path-join "file://" file-path)
+           :data-href file-path :target "_blank" :title title}
+       label])))
+
