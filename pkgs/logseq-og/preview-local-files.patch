+  // Read a bounded UTF-8 prefix only when the attachment preview is shown.
+  async readTextFilePreview (filePath) {
+    const handle = await fs.promises.open(filePath, 'r')
+    try {
+      const buffer = Buffer.alloc(8193)
+      const { bytesRead } = await handle.read(buffer, 0, buffer.length, 0)
+      const { StringDecoder } = require('string_decoder')
+      const text = new StringDecoder('utf8').write(buffer.subarray(0, Math.min(bytesRead, 8192)))
+      return { text: text.slice(0, 4000), truncated: bytesRead > 8192 || text.length > 4000 }
+    } finally {
+      await handle.close()
+    }
+  },
+
+  // PDF.js cannot fetch file:// (or assets://) from the lsp:// renderer.
+  // Transfer local bytes through the existing isolated preload bridge instead.
+  async readLocalPdf (url) {
+    const filePath = fileURLToPath(url.replace(/^assets:/, 'file:'))
+    const buffer = await fs.promises.readFile(filePath)
+    return buffer.buffer.slice(buffer.byteOffset, buffer.byteOffset + buffer.byteLength)
+  },
+
   async openPath (path) {
     await shell.openPath(path)
   },
