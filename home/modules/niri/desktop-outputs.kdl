// Match monitor identities so the layout follows them when GPU ports change.
// Keep one block per monitor, without connector-specific duplicates.
output "PNP(XYM) MQ2719-B 0000000000000" {
    mode "3840x2160@100.000"
    scale 1.5
    position x=1920 y=-360
    focus-at-startup
}

output "Philips Consumer Electronics Company PHL 243V7 0x00001AE7" {
    mode "1920x1080@60.000"
    scale 1
    position x=0 y=0
}

debug {
    honor-xdg-activation-with-invalid-serial
}
